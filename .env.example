# Copy to .env.local for local development. Set real values in
# Netlify → Site configuration → Environment variables. Never commit secrets.

# --- Public (exposed to the browser by design) ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA4_ID=

# Phase 1 — Shopify Storefront API (Headless channel)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=

# Phase 5 — ad platform pixels
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_PINTEREST_TAG_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
MAILERLITE_API_KEY=
